CXX = g++
JAVA_HOME ?= $(HOME)
ASTYLE_VERSION ?= 2.05.1

CXXFLAGS += -std=c++11 -DASTYLE_JNI
CXXFLAGS += -I"$(JAVA_HOME)/include" -I"$(JAVA_HOME)/include/win32"

SOURCES = \
	src/astyle_main.cpp \
	src/ASBeautifier.cpp \
	src/ASFormatter.cpp \
	src/ASEnhancer.cpp \
	src/ASResource.cpp

all:
	$(CXX) -shared $(CXXFLAGS) $(SOURCES) -o libastylej.dll
	mkdir -p ../../windows/libastylej-$(ASTYLE_VERSION)
	cp libastylej.dll ../../windows/libastylej-$(ASTYLE_VERSION)/AStylej.dll
